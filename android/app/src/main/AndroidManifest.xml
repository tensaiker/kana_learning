<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 
      Required for hardware vibration and haptic motors across Android devices.
      Enables HapticFeedback.vibrate(), heavyImpact(), and custom tactile patterns.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Application Node:
      - android:label: Sets the official public name displayed beneath the app icon on device home screens.
      - android:icon: References the generated launcher icon mipmaps (@mipmap/ic_launcher).
    -->
    <application
        android:label="Cozy Kana"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- 
              Specifies the Android theme applied as soon as the Android process starts.
              Managed by flutter_native_splash to show the custom launch background and logo
              before switching to NormalTheme once the Flutter engine is ready.
            -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required by Flutter engine to generate GeneratedPluginRegistrant -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- 
      Package visibility queries for text processing actions (used by ProcessTextPlugin).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>